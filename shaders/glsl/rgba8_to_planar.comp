#version 450

// Convert packed RGBA8 bytes to planar float RGB

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) readonly buffer InputRGBA {
    uint rgba[];
};

layout(set = 0, binding = 1) writeonly buffer OutputR {
    float r[];
};

layout(set = 0, binding = 2) writeonly buffer OutputG {
    float g[];
};

layout(set = 0, binding = 3) writeonly buffer OutputB {
    float b[];
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
} pc;

void main() {
    uint gx = gl_GlobalInvocationID.x;
    uint gy = gl_GlobalInvocationID.y;

    if (gx >= pc.width || gy >= pc.height) {
        return;
    }

    uint idx = gy * pc.width + gx;
    vec4 rgba_val = unpackUnorm4x8(rgba[idx]);

    r[idx] = rgba_val.r;
    g[idx] = rgba_val.g;
    b[idx] = rgba_val.b;
}
